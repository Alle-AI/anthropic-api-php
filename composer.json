{
    "name": "alle-ai/anthropic-api-php",
    "description": "The go-to PHP library for the Anthropic API — Messages, streaming, tool use, vision, prompt caching, extended thinking, MCP, Files, Batches. Maintained by Alle-AI.",
    "type": "library",
    "keywords": [
        "anthropic",
        "claude",
        "claude-code",
        "claude-api",
        "messages-api",
        "tool-use",
        "vision",
        "streaming",
        "mcp",
        "model-context-protocol",
        "prompt-caching",
        "extended-thinking",
        "ai",
        "llm",
        "alle-ai"
    ],
    "homepage": "https://github.com/Alle-AI/anthropic-api-php",
    "license": "MIT",
    "authors": [
        {
            "name": "Dickson Agyei",
            "email": "dickson@alle-ai.com",
            "homepage": "https://www.linkedin.com/in/dickson-agyei-jnr/",
            "role": "Maintainer"
        },
        {
            "name": "Alle-AI",
            "homepage": "https://alle-ai.com",
            "role": "Sponsor"
        }
    ],
    "support": {
        "issues": "https://github.com/Alle-AI/anthropic-api-php/issues",
        "source": "https://github.com/Alle-AI/anthropic-api-php",
        "docs": "https://github.com/Alle-AI/anthropic-api-php#readme",
        "email": "dickson@alle-ai.com"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "php-http/discovery": "^1.19",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/phpstan-deprecation-rules": "^1.2",
        "laravel/pint": "^1.18",
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "aws/aws-sdk-php": "^3.300",
        "google/auth": "^1.40"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required for Auth\\BedrockAuth — AWS SigV4 signing for the Bedrock runtime endpoint",
        "google/auth": "Required for Auth\\VertexAuth — Google ADC token acquisition for Vertex AI",
        "guzzlehttp/guzzle": "Default PSR-18 HTTP client used when one isn't injected",
        "infection/infection": "Mutation testing for contributors"
    },
    "autoload": {
        "psr-4": {
            "AlleAI\\Anthropic\\": "src/Anthropic/",
            "AlleAI\\AlleAI\\": "src/AlleAI/",
            "Alle_AI\\Anthropic\\": "src/Legacy/Alle_AI/Anthropic/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlleAI\\Anthropic\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:contract": "phpunit --testsuite=Contract",
        "stan": "phpstan analyse --no-progress",
        "lint": "pint --test",
        "fix": "pint",
        "ci": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    }
}
